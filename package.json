{
  "name": "emdash-commerce",
  "version": "0.0.1",
  "description": "Commerce for EmDash: a Stripe plugin, an image-hotspots field widget, a Cloudflare-orange design system and a mock Cloudflare-merch demo storefront - one Nx + pnpm monorepo.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "nx run storefront:dev",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "check:ai": "node scripts/check-ai-structure.mjs",
    "lint": "oxlint",
    "seed": "node scripts/seed-demo.mjs",
    "catalog:resync": "node scripts/catalog-resync.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/bootstrap.mjs --check",
    "art": "node scripts/art/index.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "E2E_STRIPE=off playwright test --project=smoke",
    "test:e2e:cloudflare": "E2E_TARGET=cloudflare playwright test",
    "test:e2e:smoke:cloudflare": "E2E_TARGET=cloudflare E2E_STRIPE=off playwright test --project=smoke",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "nx": "22.7.0",
    "oxlint": "1.94.0",
    "sharp": "0.34.5",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "better-sqlite3",
      "nx",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "19.2.8",
      "@types/react-dom": "19.2.3"
    }
  }
}
