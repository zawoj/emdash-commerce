{
  "name": "emdash-commerce",
  "version": "0.0.1",
  "description": "Commerce for EmDash: a Stripe plugin, an image-hotspots field widget, a sportswear design system and a demo storefront - one Nx + pnpm monorepo.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "nx run storefront:dev",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "check:ai": "node scripts/check-ai-structure.mjs",
    "seed": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "nx": "22.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "better-sqlite3",
      "nx",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "19.2.8",
      "@types/react-dom": "19.2.3"
    }
  }
}
