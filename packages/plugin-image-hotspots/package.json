{
  "name": "@emdash-commerce/plugin-image-hotspots",
  "version": "0.1.0",
  "description": "Image hotspots field widget for EmDash CMS: place numbered points on an image, link them to products or callouts. Community project, not official.",
  "keywords": [
    "emdash",
    "cms",
    "plugin",
    "field-widget",
    "hotspots",
    "image",
    "react",
    "shop-the-look"
  ],
  "homepage": "https://github.com/zawoj/emdash-commerce/tree/main/packages/plugin-image-hotspots#readme",
  "bugs": {
    "url": "https://github.com/zawoj/emdash-commerce/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zawoj/emdash-commerce.git",
    "directory": "packages/plugin-image-hotspots"
  },
  "license": "MIT",
  "author": "Kacper Zawojski",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./admin": {
      "types": "./src/admin/index.ts",
      "default": "./src/admin/index.ts"
    },
    "./value": {
      "types": "./src/value/index.ts",
      "default": "./src/value/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@emdash-cms/admin": "^1.5.0",
    "emdash": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@emdash-cms/admin": "1.5.0",
    "@types/node": "^24.6.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "emdash": "^1.5.0",
    "happy-dom": "20.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  }
}
