---
// The number on the cart icon. The wrapper is a polite live region that is always in the page, so a
// change is announced; the visible bubble is hidden at 0. The client script
// (`@emdash-commerce/design-system/count-badge`) updates every badge when `cart:changed` fires with
// `detail: { count }`.
import type { CountBadgeProps } from './types'

type Props = CountBadgeProps

const { count, labelTemplate, max = 99 } = Astro.props
const shown = count > max ? `${max}+` : String(count)
const spoken = labelTemplate.replace('{count}', String(count))
---

<span class="count-badge" role="status" data-count-badge data-label-template={labelTemplate} data-max={max}>
  <span class="count-badge__bubble" aria-hidden="true" hidden={count <= 0} data-count-bubble>{shown}</span>
  <span class="visually-hidden" data-count-spoken>{spoken}</span>
</span>

<script>
  import '@emdash-commerce/design-system/count-badge'
</script>

<style>
  .count-badge {
    display: inline-flex;
  }

  .count-badge__bubble {
    display: inline-flex;
    min-width: 18px; /* token-lint-ignore: bubble holds two digits */
    height: 18px; /* token-lint-ignore: bubble holds two digits */
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-4);
    border-radius: var(--radius-full);
    background: var(--text-primary);
    color: var(--surface);
    font: var(--type-label-semibold-xs);
    font-variant-numeric: tabular-nums;
  }

  .count-badge__bubble[hidden] {
    display: none;
  }
</style>
