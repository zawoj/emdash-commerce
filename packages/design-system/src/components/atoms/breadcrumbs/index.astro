---
// Breadcrumbs — an optional caption above a crumb path; the last item is the current
// page (not a link). The separator is a decorative inline chevron, not caller content, so it is
// drawn once per gap instead of being threaded through a slot. The path is one line: the first crumb
// and the current page keep their text as far as they can, the middle crumbs give way first and end in an
// ellipsis. On a phone (<= 767px) the trail gives way to an app-style top bar: a back chevron and the name of the
// nearest linkable ancestor ("‹ Koszulki"), a real link that spans the bar (no history.back, see back-link); a page with no
// ancestor shows nothing there. The same <nav> serves both, so the structured data the page emits is unaffected.
import BackLink from '../back-link/index.astro'
import { parentCrumb } from './parent-crumb'

export interface BreadcrumbItem {
  readonly label: string
  readonly href?: string
}

interface Props {
  items: readonly BreadcrumbItem[]
  label?: string
  ariaLabel?: string
  /** The phone back link's accessible name, with `{label}` for the ancestor ("Wróć do: {label}"). */
  backLabel?: string
}

const { items, label, ariaLabel, backLabel } = Astro.props
const parent = parentCrumb(items)
---

<nav class:list={['breadcrumbs', !parent && 'breadcrumbs--no-parent']} aria-label={ariaLabel}>
  {label && <p class="breadcrumbs__label">{label}</p>}
  {parent && <BackLink href={parent.href} label={parent.label} ariaLabel={backLabel?.replace('{label}', parent.label)} />}
  <ol class="breadcrumbs__path">
    {
      items.map((item, index) => {
        const isCurrent = index === items.length - 1
        return (
          <li>
            {!isCurrent && item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current={isCurrent ? 'page' : undefined}>{item.label}</span>
            )}
            {!isCurrent && (
              <svg class="breadcrumbs__separator" aria-hidden="true" viewBox="0 0 12 12" width="12" height="12">
                <path
                  d="M4.5 2.5 L8 6 L4.5 9.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </li>
        )
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .breadcrumbs__label {
    font: var(--type-label-medium-sm);
    color: var(--text-muted);
  }

  .breadcrumbs__path {
    display: flex;
    list-style: none;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-6);
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs__path li {
    display: flex;
    flex: 0 3 auto;
    align-items: center;
    gap: var(--space-6);
    min-width: 3ch; /* token-lint-ignore: keeps an ellipsis visible */
  }

  .breadcrumbs__path li:first-child {
    flex-shrink: 0;
  }

  .breadcrumbs__path li:last-child {
    flex-shrink: 1;
    min-width: 8ch; /* token-lint-ignore: the current page keeps a readable stub */
  }

  .breadcrumbs__path a,
  .breadcrumbs__path span {
    font: var(--type-text-regular-xs);
    color: var(--text-secondary);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .breadcrumbs__path a:hover {
      color: var(--text-primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .breadcrumbs__path li:last-child span {
    color: var(--text-primary);
  }

  .breadcrumbs__separator {
    flex: none;
    color: var(--text-subtle);
  }

  @media (pointer: coarse) {
    .breadcrumbs__path a {
      display: inline-flex;
      align-items: center;
      min-height: 44px; /* token-lint-ignore: touch target */
    }
  }

  /* Phone: the trail gives way to the back bar (BackLink), which sits flush under the header. */
  @media (max-width: 767px) {
    .breadcrumbs--no-parent {
      display: none;
    }

    .breadcrumbs {
      gap: 0;
    }

    .breadcrumbs__label,
    .breadcrumbs__path {
      display: none;
    }
  }
</style>
