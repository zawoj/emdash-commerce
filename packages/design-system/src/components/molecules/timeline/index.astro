---
// An ordered list of events (order progress, return status): a rail with a marker per step — a check
// for done, a filled square for the current one, a hollow square for upcoming — the label, the
// optional description and the date.
import Icon from '../../atoms/icon/index.astro'
import { iconNames } from '../../atoms/icon/names'
import { timelineStates } from './variants'
import type { TimelineProps } from './types'

type Props = TimelineProps

const { items, label } = Astro.props
---

<ol class="timeline" aria-label={label}>
  {
    items.map((item) => (
      <li class:list={['timeline__item', `timeline__item--${item.state}`]} aria-current={item.state === timelineStates.current ? 'step' : undefined}>
        <span class="timeline__marker" aria-hidden="true">
          {item.state === timelineStates.done && <Icon name={iconNames.check} size={12} />}
        </span>
        <div class="timeline__body">
          <p class="timeline__label">
            <span class="visually-hidden">{item.stateLabel}: </span>{item.label}
          </p>
          {item.description && <p class="timeline__description">{item.description}</p>}
          {item.date && <time class="timeline__date" datetime={item.date.iso}>{item.date.label}</time>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: flex;
    gap: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  /* The rail runs from this marker to the next. */
  .timeline__item:not(:last-child)::before {
    position: absolute;
    top: var(--space-20);
    bottom: 0;
    left: 9px; /* token-lint-ignore: centre of the 20px marker */
    border-left: var(--stroke-thin) solid var(--border);
    content: '';
  }

  .timeline__item--upcoming:not(:last-child)::before {
    border-left-style: dashed;
  }

  .timeline__marker {
    display: inline-flex;
    flex: none;
    width: 20px; /* token-lint-ignore: marker box */
    height: 20px; /* token-lint-ignore: marker box */
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--on-control-solid);
  }

  .timeline__item--done .timeline__marker {
    border-color: var(--control-solid);
    background: var(--control-solid);
  }

  .timeline__item--current .timeline__marker {
    border: 2px solid var(--control-edge);
    background: var(--accent);
    color: var(--on-accent);
  }

  .timeline__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .timeline__label {
    margin: 0;
    color: var(--text-primary);
    font: var(--type-text-medium-md);
  }

  .timeline__item--upcoming .timeline__label {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .timeline__description {
    margin: 0;
    color: var(--text-body);
    font: var(--type-text-regular-sm);
  }

  .timeline__date {
    color: var(--text-secondary);
    font: var(--type-label-regular-xs);
  }
</style>
