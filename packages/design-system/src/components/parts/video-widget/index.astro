---
// Figma sidebar "tile-youtube" widget-R (931:31892, "polecany film", identical on artykul /
// wpisy-z-kategorii / zawody): the YouTube tile shell at sidebar size around one wide video card
// with the channel avatar (ZOAHg).
import VideoCard from '../video-card/index.astro'
import { videoCardSizes } from '../video-card/variants'
import YoutubeTile from '../youtube-tile/index.astro'
import { youtubeTileSizes } from '../youtube-tile/variants'
import type { VideoWidgetContent } from './types'

type Props = VideoWidgetContent

const { heading, headingId, video } = Astro.props
---

<YoutubeTile heading={heading} headingId={headingId} size={youtubeTileSizes.sidebar}>
  <VideoCard video={video} size={videoCardSizes.wide} />
</YoutubeTile>
