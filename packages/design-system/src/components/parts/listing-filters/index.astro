---
// The filter panel of a listing: a GET form of facet groups (checkbox lists with counts, a price
// range, option chips), the applied filters as removable chips with "clear all", and an apply button.
// The panel is a <details> that is open in the markup — an inline script right after it collapses it on a phone
// before the first paint (so the results never shift), the module script keeps it that way and
// the toolbar's link toggles it (the panel's own summary row is hidden on a phone) — so it works without a script.
// On a phone, while the panel is open, a "Show results (N)" bar is fixed to the bottom (it takes the tab bar's place). The applied filters sit above the
// panel, outside the <details>, so they stay visible while it is collapsed. Parameters in `keep` survive applying.
import Button from '../../atoms/button/index.astro'
import { buttonSizes, buttonVariants } from '../../atoms/button/variants'
import Icon from '../../atoms/icon/index.astro'
import { iconNames } from '../../atoms/icon/names'
import OptionChip from '../../atoms/option-chip/index.astro'
import { filterGroupKinds } from './variants'
import type { ListingFiltersProps } from './types'

type Props = ListingFiltersProps

const { id, action, title, groups, activeFilters = [], clearAll, keep = {}, submitLabel, activeLabel, countLabel, resultsLabel } = Astro.props
const activeCount = activeFilters.length
---

  {
    activeCount > 0 && (
      <div class="listing-filters__active">
        {activeLabel && <p class="visually-hidden">{activeLabel}</p>}
        <ul class="listing-filters__chips">
          {activeFilters.map((filter) => (
            <li>
              <a class="listing-filters__chip" href={filter.removeHref} aria-label={filter.removeLabel}>
                {filter.label}
                <Icon name={iconNames.x} size={12} />
              </a>
            </li>
          ))}
        </ul>
        {clearAll && <a class="listing-filters__clear" href={clearAll.href}>{clearAll.label}</a>}
      </div>
    )
  }

<details class="listing-filters" id={id} open data-details-motion data-listing-filters data-active-count={activeCount}>
  <summary class="listing-filters__summary">
    <span class="listing-filters__title">{title}{activeCount > 0 && <span class="listing-filters__active-count"> ({activeCount})</span>}</span>
    <span class="listing-filters__chevron" aria-hidden="true"><span class="listing-filters__glyph listing-filters__glyph--closed"><Icon name={iconNames.chevronDown} /></span><span class="listing-filters__glyph listing-filters__glyph--open"><Icon name={iconNames.chevronUp} /></span></span>
  </summary>

  <form class="listing-filters__form" action={action} method="get" data-auto-submit>
    {Object.entries(keep).map(([name, value]) => <input type="hidden" name={name} value={value} />)}

    {
      groups.map((group) => (
        <details class="listing-filters__group" open={group.isOpen ?? true} data-details-motion>
          <summary class="listing-filters__group-summary">
            <span id={`${group.id}-label`}>{group.label}</span>
            <span class="listing-filters__chevron" aria-hidden="true"><span class="listing-filters__glyph listing-filters__glyph--closed"><Icon name={iconNames.chevronDown} /></span><span class="listing-filters__glyph listing-filters__glyph--open"><Icon name={iconNames.chevronUp} /></span></span>
          </summary>
          <fieldset class="listing-filters__fieldset" aria-labelledby={`${group.id}-label`}>
            {group.kind === filterGroupKinds.checkbox && (
              <ul class="listing-filters__options">
                {group.options.map((option, index) => (
                  <li>
                    <label class="listing-filters__option" for={`${group.id}-${index}`}>
                      <input id={`${group.id}-${index}`} type="checkbox" name={group.name} value={option.value} checked={option.isChecked} />
                      <span class="listing-filters__option-label">{option.label}</span>
                      {option.count !== undefined && (
                        <span class="listing-filters__count">
                          <span aria-hidden="true">({option.count})</span>
                          <span class="visually-hidden">{countLabel ? `(${option.count} ${countLabel})` : `(${option.count})`}</span>
                        </span>
                      )}
                    </label>
                  </li>
                ))}
              </ul>
            )}
            {group.kind === filterGroupKinds.chips && (
              <div class="listing-filters__chip-options">
                {group.options.map((option, index) => (
                  <OptionChip id={`${group.id}-${index}`} name={group.name} kind="checkbox" option={option} soldOutLabel={group.soldOutLabel} />
                ))}
              </div>
            )}
            {group.kind === filterGroupKinds.range && (
              <div class="listing-filters__range">
                {[group.min, group.max].map((bound, index) => (
                  <>
                    {index === 1 && <span class="listing-filters__range-dash" aria-hidden="true">–</span>}
                    <label class="listing-filters__range-field" for={`${group.id}-${index === 0 ? 'min' : 'max'}`}>
                      <span class="visually-hidden">{bound.label}</span>
                      <input
                        id={`${group.id}-${index === 0 ? 'min' : 'max'}`}
                        type="number"
                        inputmode="numeric"
                        min="0"
                        name={bound.name}
                        value={bound.value}
                        placeholder={bound.placeholder}
                      />
                    </label>
                  </>
                ))}
                {group.unit && <span class="listing-filters__unit">{group.unit}</span>}
              </div>
            )}
          </fieldset>
        </details>
      ))
    }

    <div class="listing-filters__submit" data-auto-submit-hide>
      <Button type="submit" variant={buttonVariants.primary} size={buttonSizes.sm}>{submitLabel}</Button>
    </div>
  </form>

  {
    resultsLabel && (
      <div class="listing-filters__bar" data-surface="light">
        <Button type="button" variant={buttonVariants.primary} size={buttonSizes.lg} data-filters-show-results>{resultsLabel}</Button>
      </div>
    )
  }
</details>
{/* Collapses the panel on a phone before the first paint (the module script would do it after load and shift
    the results); the same query and keep-open flag as utils/listing-filters.ts. */}
<script is:inline>
  ;(function (panel) {
    try {
      if (window.matchMedia('(max-width: 899px)').matches && window.sessionStorage.getItem('listing-filters-open') !== '1') panel.open = false
    } catch (error) {}
  })(document.currentScript.previousElementSibling)
</script>

<script>
  import '../../../utils/details-motion'
  import '@emdash-commerce/design-system/listing-filters'
</script>

<style>
  .listing-filters {
    background: var(--surface);
  }

  .listing-filters__summary,
  .listing-filters__group-summary {
    display: flex;
    min-height: 48px; /* token-lint-ignore: touch target */
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding: var(--space-8) 0;
    cursor: pointer;
    list-style: none;
  }

  .listing-filters__summary::-webkit-details-marker,
  .listing-filters__group-summary::-webkit-details-marker {
    display: none;
  }

  .listing-filters__summary:focus-visible,
  .listing-filters__group-summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .listing-filters__title {
    color: var(--text-primary);
    font: var(--type-label-caps-xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
  }

  .listing-filters__active-count {
    font-weight: 400;
  }

  .listing-filters__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; /* token-lint-ignore: hover disc around the chevron */
    height: 32px; /* token-lint-ignore: hover disc around the chevron */
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  .listing-filters__glyph {
    display: inline-flex;
  }

  .listing-filters__glyph--open,
  .listing-filters[open]:not([data-closing]) > .listing-filters__summary .listing-filters__glyph--closed,
  .listing-filters__group[open]:not([data-closing]) > .listing-filters__group-summary .listing-filters__glyph--closed {
    display: none;
  }

  .listing-filters[open]:not([data-closing]) > .listing-filters__summary .listing-filters__glyph--open,
  .listing-filters__group[open]:not([data-closing]) > .listing-filters__group-summary .listing-filters__glyph--open {
    display: inline-flex;
  }

  @media (hover: hover) {
    .listing-filters__summary:hover .listing-filters__chevron,
    .listing-filters__group-summary:hover .listing-filters__chevron {
      background: var(--surface-muted);
      color: var(--text-primary);
    }
  }

  /* On a phone the toolbar's "Filters" toggle is the only entry point: the panel has no summary row of its own. */
  @media (max-width: 899px) {
    .listing-filters__summary {
      display: none;
    }
  }

  .listing-filters__active {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    margin-bottom: var(--space-16);
  }

  .listing-filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .listing-filters__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 32px; /* token-lint-ignore: chip height */
    padding: 0 var(--space-12);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface-muted);
    color: var(--text-primary);
    font: var(--type-text-regular-sm);
    text-decoration: none;
  }

  .listing-filters__chip:hover {
    background: var(--surface-hover);
  }

  .listing-filters__chip:focus-visible,
  .listing-filters__clear:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .listing-filters__clear {
    color: var(--link);
    font: var(--type-text-medium-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .listing-filters__form {
    display: flex;
    flex-direction: column;
  }

  .listing-filters__group {
    border-top: 1px solid var(--border);
  }

  .listing-filters__group-summary {
    color: var(--text-primary);
    font: var(--type-text-medium-sm);
  }

  .listing-filters__group:last-of-type {
    border-bottom: 1px solid var(--border);
  }

  .listing-filters__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0 0 var(--space-16);
    border: 0;
  }

  .listing-filters__options {
    display: flex;
    max-height: 16rem;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  .listing-filters__option {
    display: flex;
    min-height: 36px; /* token-lint-ignore: touch target in a dense list */
    align-items: center;
    gap: var(--space-8);
    color: var(--text-body);
    font: var(--type-text-regular-sm);
    cursor: pointer;
  }

  .listing-filters__option input {
    flex: none;
    width: 16px; /* token-lint-ignore: native checkbox box */
    height: 16px; /* token-lint-ignore: native checkbox box */
    margin: 0;
    accent-color: var(--ink-1000);
  }

  .listing-filters__count {
    margin-left: auto;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .listing-filters__chip-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .listing-filters__range {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .listing-filters__range-field {
    flex: 1;
    min-width: 0;
  }

  .listing-filters__range-field input {
    width: 100%;
    height: 40px; /* token-lint-ignore: control height */
    padding: 0 var(--space-12);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-field);
    background: var(--surface);
    color: var(--text-body);
    font: var(--type-text-regular-sm);
  }

  .listing-filters__range-dash,
  .listing-filters__unit {
    color: var(--text-secondary);
    font: var(--type-text-regular-sm);
  }

  .listing-filters__submit {
    padding: var(--space-16) 0;
  }

  .listing-filters__submit[hidden] {
    display: none;
  }

  @media (pointer: coarse) {
    .listing-filters__chip,
    .listing-filters__clear,
    .listing-filters__option {
      min-height: 44px; /* token-lint-ignore: touch target */
    }

    .listing-filters__clear {
      display: inline-flex;
      align-items: center;
    }
  }

  @media (pointer: coarse) {
    .listing-filters__range-field input {
      height: 44px; /* token-lint-ignore: touch target */
      font: var(--type-text-regular-md); /* 16px: iOS does not zoom the page on focus */
    }
  }

  /* The bar exists on a phone only. Fixed inside the open <details>: a folded panel hides it with its content. */
  .listing-filters__bar {
    display: none;
  }

  @media (max-width: 767px) {
    .listing-filters__bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 30; /* token-lint-ignore: same layer as the tab bar it replaces */
      display: block;
      padding: var(--space-12) var(--page-gutter) calc(var(--space-12) + env(safe-area-inset-bottom, 0px));
      background: var(--surface);
      border-top: var(--stroke-thin) solid var(--border);
    }

    .listing-filters__bar :global(.button) {
      width: 100%;
    }
  }
</style>
