---
// An author's introduction above their posts: a round photo beside the role, the bio and the links
// to their profiles. Renders nothing without any of them.
import type { AuthorProfileContent } from './types'
import Image from '../../atoms/image/index.astro'

type Props = AuthorProfileContent

const { photo, role, bio, links } = Astro.props
const hasContent = Boolean(photo || role || bio || links.length > 0)
---

{
  hasContent && (
    <section class="author-profile">
      {photo && <Image class="author-profile__photo" {...photo} />}
      <div class="author-profile__text">
        {role && <p class="author-profile__role">{role}</p>}
        {bio && <p class="author-profile__bio">{bio}</p>}
        {
          links.length > 0 && (
            <ul class="author-profile__links">
              {links.map((link) => (
                <li>
                  <a href={link.href} rel="me noopener" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  )
}

<style>
  .author-profile {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-24);
    padding: var(--space-24) 0;
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .author-profile__photo {
    flex: none;
    width: 96px; /* token-lint-ignore: author photo size, no token */
    height: 96px; /* token-lint-ignore: author photo size, no token */
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .author-profile__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }

  .author-profile__role {
    margin: 0;
    font: var(--type-label-caps-2xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    color: var(--text-secondary);
    text-transform: var(--label-case);
  }

  .author-profile__bio {
    margin: 0;
    font: var(--type-text-regular-md);
    color: var(--text-body);
  }

  .author-profile__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .author-profile__links a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-profile__links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .author-profile {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-16);
      padding: var(--space-16) 0;
    }
  }
</style>
