---
// The "skip to content" link: out of sight until it takes keyboard focus, then pinned over the header.
interface Props {
  href: string
  label: string
}

const { href, label } = Astro.props
---

<a class="skip-link" href={href}>{label}</a>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-16);
    left: var(--space-16);
    z-index: 100;
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-control);
    background: var(--control-solid);
    color: var(--on-control-solid);
    font: var(--type-button-sm);
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-16)));
  }

  .skip-link:focus {
    transform: none;
  }
</style>
