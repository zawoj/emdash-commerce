---
// Figma "tile" "hot" (944:29127): the red tile-title with the fire icon over two rows of two
// stacked card-articles (20px titles; the first row carries the author).
import Icon from '../../../atoms/icon/index.astro'
import { iconNames } from '../../../atoms/icon/names'
import TileTitle from '../../../molecules/tile-title/index.astro'
import { tileTitleTones } from '../../../molecules/tile-title/variants'
import ArticleCard from '../../../parts/article-card/index.astro'
import { articleCardSizes } from '../../../parts/article-card/variants'
import type { HeroHomeHot } from './types'

type Props = HeroHomeHot

const { heading, headingId, articles } = Astro.props
---

<section class="hot-tile" aria-labelledby={headingId}>
  <div class="hot-tile__title">
    <TileTitle heading={heading} headingId={headingId} tone={tileTitleTones.hot}>
      <Icon name={iconNames.fire} slot="before-heading" />
    </TileTitle>
  </div>
  <div class="hot-tile__grid">
    {articles.map((article) => <ArticleCard article={article} size={articleCardSizes.l} />)}
  </div>
</section>

<style>
  .hot-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    min-width: 0;
    padding: var(--space-32) var(--space-24);
    border-radius: var(--radius-card);
    background: var(--surface-muted);
  }

  /* The fire glyph (currentColor) matches the "Red" tile-title's heading. */
  .hot-tile__title {
    color: var(--text-primary);
  }

  .hot-tile__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-32) var(--space-24);
  }

  @media (max-width: 640px) {
    .hot-tile {
      padding: var(--space-24) var(--space-16);
    }

    .hot-tile__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
  }
</style>
