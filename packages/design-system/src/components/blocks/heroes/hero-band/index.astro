---
// Figma "section" > "container" of the listing views (944:39843, 1023:67057, 1023:67179,
// wyszukiwanie 1022:54426, kalendarz 1023:58302): a 12px-radius band, 64px tall padding, its
// 1280px "wrapper" centered. With a category the band takes the category color and opens with the
// inverted Category Label; the row pairs the display-3xl headline with the justified description
// (+ the strategic-partner tile, 1023:67103). Without a category it is the dark band with the
// headline alone. The `centered` variant is the discounts listing's hero (1017:40793): the centred
// two-line title and the intro in a 680px column.
import { categoryColor } from '../../../../utils/category-color'
import CategoryLabel from '../../../atoms/category-label/index.astro'
import { categoryLabelSizes } from '../../../atoms/category-label/variants'
import NbspText from '../../../atoms/nbsp-text/index.astro'
import type { HeroBandProps } from './types'
import { heroBandDescriptionWeights, heroBandVariants } from './variants'
import Image from '../../../atoms/image/index.astro'

type Props = HeroBandProps

const {
  title,
  headingId,
  description,
  category,
  partner,
  descriptionWeight = heroBandDescriptionWeights.regular,
  variant = heroBandVariants.band,
} = Astro.props
const bandColor = (category && categoryColor(category)) ?? 'var(--ink-1000)'
---

{
  variant === heroBandVariants.centered ? (
    <section class="hero-centered" aria-labelledby={headingId}>
      <div class="hero-centered__container">
        <div class="hero-centered__wrapper">
          <div class="hero-centered__title-main">
            <h1 id={headingId}>{title}</h1>
          </div>
          {description && <p>{description}</p>}
        </div>
      </div>
    </section>
  ) : (
    <section class="listing-hero" aria-labelledby={headingId}>
      <div class="listing-hero__band" style={`--listing-hero-color: ${bandColor}`} data-surface={category ? undefined : 'dark'}>
        <div class="listing-hero__wrapper">
          {
            category && (
              <CategoryLabel category={category.key} color={category.color} size={categoryLabelSizes.l} isInverted>
                {category.label}
              </CategoryLabel>
            )
          }
          <div class="listing-hero__row">
            <h1 class="listing-hero__title" id={headingId}>{title}</h1>
            {
              (description || partner) && (
                <div class="listing-hero__aside">
                  {description && (
                    <p class:list={['listing-hero__description', `listing-hero__description--${descriptionWeight}`]}>
                      <NbspText text={description} />
                    </p>
                  )}
                  {partner && (partner.href ? (
                    <a class="listing-hero__partner" href={partner.href} rel="sponsored noopener">
                      <span class="listing-hero__partner-caption">{partner.caption}</span>
                      <span class="listing-hero__partner-logo">{partner.logo ? <Image {...partner.logo} alt={partner.logo.alt || partner.name} /> : <span class="listing-hero__partner-name">{partner.name}</span>}</span>
                    </a>
                  ) : (
                    <div class="listing-hero__partner">
                      <span class="listing-hero__partner-caption">{partner.caption}</span>
                      <span class="listing-hero__partner-logo">{partner.logo ? <Image {...partner.logo} alt={partner.logo.alt || partner.name} /> : <span class="listing-hero__partner-name">{partner.name}</span>}</span>
                    </div>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .listing-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-24);
    background: var(--page-bg);
  }

  /* Figma pads the band 64px vertically only and caps its wrapper at 1280px; the 32px inline
     padding keeps narrower bands off the edges and is absorbed by the centering at 1440. */
  .listing-hero__band {
    position: relative;
    display: flex;
    flex-direction: row;
    justify-content: center;
    width: 100%;
    max-width: calc(var(--page-max-width) - 2 * var(--space-24));
    padding: var(--space-80) var(--space-40);
    border-radius: var(--radius-card);
    background: var(--listing-hero-color);
    overflow: hidden;
  }

  .listing-hero__wrapper {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-32);
    min-width: 0;
    max-width: 1280px; /* token-lint-ignore: Figma wrapper max-width, no token */
  }

  .listing-hero__row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-64);
    width: 100%;
  }

  .listing-hero__title,
  .listing-hero__aside {
    flex: 1 1 0;
    min-width: 0;
  }

  .listing-hero__title {
    margin: 0;
    color: var(--ink-0);
    font: var(--type-display-3xl);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-display);
    text-transform: var(--text-case);
    text-wrap: balance;
  }

  .listing-hero__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .listing-hero__description {
    margin: 0;
    color: var(--ink-0);
    text-align: start;
  }

  .listing-hero__description--regular {
    font: var(--type-text-regular-lg);
  }

  .listing-hero__description--medium {
    font: var(--type-text-medium-lg);
  }

  /* A flat light tile: the caption cell, then the logo panel filling the rest. */
  .listing-hero__partner {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 87px; /* token-lint-ignore: Figma partner tile height, no token */
    border-radius: var(--radius-card);
    background: var(--ink-50);
    overflow: hidden;
    text-decoration: none;
  }

  /* An expanded caps label in the category color under a 10% black overlay. */
  .listing-hero__partner-caption {
    flex: none;
    box-sizing: content-box;
    width: 117px; /* token-lint-ignore: Figma caption width, no token */
    padding: var(--space-16);
    color: color-mix(in srgb, var(--listing-hero-color), var(--ink-1000) 10%);
    font: var(--type-label-caps-2xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
  }

  /* Figma 1023:67106: the category color under a 5% black overlay, the logo centered. */
  .listing-hero__partner-logo {
    display: flex;
    flex: 1 1 0;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: var(--space-20);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--listing-hero-color), var(--ink-1000) 5%);
  }

  .listing-hero__partner-name {
    color: var(--ink-950);
    font: var(--type-label-caps-xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: var(--label-case);
  }

  /* The logo as a flat white whatever its own colours. */
  .listing-hero__partner-logo :global(img) {
    display: block;
    max-width: 100%;
    height: 35px; /* token-lint-ignore: Figma partner logo height 35px */
    width: auto;
    filter: brightness(0) invert(1);
  }

  @media (max-width: 1100px) {
    .listing-hero__row {
      gap: var(--space-40);
    }

    .listing-hero__title {
      font: var(--type-display-2xl);
      font-stretch: var(--display-stretch);
    }
  }

  @media (max-width: 900px) {
    .listing-hero__row {
      flex-direction: column;
      gap: var(--space-24);
    }

    .listing-hero__title,
    .listing-hero__aside {
      flex: none;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .listing-hero {
      padding: var(--space-16);
    }

    .listing-hero__band {
      padding: var(--space-40) var(--space-20);
    }

    .listing-hero__wrapper {
      gap: var(--space-24);
    }

    .listing-hero__title {
      font: var(--type-display-lg);
      font-stretch: var(--display-stretch);
    }

    .listing-hero__description {
      text-align: start;
    }

    .listing-hero__partner {
      flex-direction: column;
      align-items: stretch;
      height: auto;
    }

    .listing-hero__partner-caption {
      width: auto;
      text-align: center;
    }
  }

  /* The centered variant. 1017:40794 "container" (max 1400) -> 1017:40832 "wrapper" (max 680) ->
     "title-wrap" (gap 16). */
  .hero-centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-24);
  }

  .hero-centered__container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    width: 100%;
    max-width: 1400px; /* token-lint-ignore: Figma container max width, no token */
    padding: var(--space-40) 0;
  }

  .hero-centered__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    width: 100%;
    max-width: 680px; /* token-lint-ignore: Figma wrapper max width, no token */
  }

  .hero-centered__title-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
    width: 100%;
  }

  .hero-centered h1 {
    width: 100%;
    max-width: 663.386px; /* token-lint-ignore: Figma title box width, no token */
    margin: 0;
    color: var(--text-primary);
    font: var(--type-display-3xl);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-display);
    text-align: center;
    text-transform: var(--text-case);
    text-wrap: balance;
  }

  .hero-centered p {
    width: 100%;
    margin: 0;
    color: var(--text-secondary);
    font: var(--type-text-regular-md);
    text-align: center;
  }

  @media (max-width: 640px) {
    .hero-centered {
      padding: var(--space-16);
    }

    .hero-centered__container {
      padding: var(--space-24) 0;
    }

    .hero-centered h1 {
      font: var(--type-display-lg);
      font-stretch: var(--display-stretch);
    }
  }
</style>
