---
// The "storySplit" section: an editorial story. The photo is sticky on one side; two or three chapters
// (index, condensed caps title, paragraph, optional link) scroll past on the other. Phones: photo
// first, then the chapters.
import Image from '../../../atoms/image/index.astro'
import type { StorySplitProps } from './types'
import { storySplitSides } from './variants'

type Props = StorySplitProps

const { heading, headingId, image, side = storySplitSides.start, chapters } = Astro.props
---

<section class:list={['story', `story--${side}`]} aria-labelledby={headingId}>
  <div class="story__photo">
    <Image {...image} class="story__img" sizes="(min-width: 900px) 46vw, 100vw" />
  </div>
  <div class="story__text">
    <h2 class="story__heading" id={headingId}>{heading}</h2>
    {
      chapters.map((chapter) => (
        <article class="story__chapter">
          {chapter.eyebrow && <p class="story__eyebrow">{chapter.eyebrow}</p>}
          <h3 class="story__title">{chapter.title}</h3>
          <p class="story__body">{chapter.text}</p>
          {chapter.link && <a class="story__link" href={chapter.link.href}>{chapter.link.label}</a>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 12fr);
    align-items: start;
    column-gap: var(--space-64);
    padding-block: var(--space-24);
    color: var(--text-primary);
  }

  .story--end {
    grid-template-columns: minmax(0, 12fr) minmax(0, 11fr);
  }

  .story--end .story__photo {
    grid-column: 2;
    grid-row: 1;
  }

  .story--end .story__text {
    grid-column: 1;
    grid-row: 1;
  }

  .story__photo {
    position: sticky;
    top: calc(var(--header-height) + var(--space-24));
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-muted);
  }

  .story__photo :global(.story__img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100vh - var(--header-height) - var(--space-48));
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .story__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .story__heading {
    margin: 0 0 var(--space-48);
    font: var(--type-label-caps-xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
    color: var(--text-secondary);
  }

  .story__chapter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
    min-height: 50vh; /* token-lint-ignore: each chapter holds the photo for a screen of scrolling */
    padding-block: var(--space-48);
    border-top: var(--stroke-thin) solid var(--border);
  }

  .story__eyebrow {
    margin: 0;
    font: var(--type-display-xl);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-display);
    color: var(--text-secondary);
  }

  .story__title {
    margin: 0;
    max-width: 12ch; /* token-lint-ignore: balanced short lines of display type */
    font: var(--type-display-3xl);
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-display);
    text-transform: var(--text-case);
    text-wrap: balance;
  }

  .story__body {
    margin: 0;
    max-width: 44ch; /* token-lint-ignore: readable line length */
    font: var(--type-text-regular-lg);
    color: var(--text-body);
  }

  .story__link {
    font: var(--type-text-medium-md);
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 4px; /* token-lint-ignore: underline offset */
  }

  .story__link:hover {
    text-decoration-thickness: var(--stroke-bold);
  }

  @media (max-width: 700px) {
    .story,
    .story--end {
      grid-template-columns: minmax(0, 1fr);
    }

    .story--end .story__photo,
    .story--end .story__text {
      grid-column: 1;
      grid-row: auto;
    }

    .story__photo {
      position: static;
    }

    .story__photo :global(.story__img) {
      aspect-ratio: 1 / 1;
      max-height: none;
    }

    .story__chapter {
      min-height: 0;
      padding-block: var(--space-32);
    }

    .story__heading {
      margin-top: var(--space-24);
      margin-bottom: var(--space-16);
    }

    .story__title {
      font: var(--type-display-xl);
      font-stretch: var(--display-stretch);
      letter-spacing: var(--tracking-display);
    }

    .story__eyebrow {
      font: var(--type-display-md);
      font-stretch: var(--display-stretch);
    }
  }

  @media (pointer: coarse) {
    .story__link {
      display: inline-flex;
      align-items: center;
      min-height: 44px; /* token-lint-ignore: touch target */
    }
  }
</style>
