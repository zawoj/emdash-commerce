---
// The board hero: a tight mosaic (4px gaps on the grey frame) of the campaign photo with the huge
// headline and the volt call to action, a volt block with the first half of the brand line, a black
// block with the second half and the site wordmark, and one product as a packshot tile. It breaks out
// of the page column; its height leaves a slice of the next section visible. Phone: photo first, the
// volt and black blocks side by side, then the product.
import Button from '../../../atoms/button/index.astro'
import SiteWordmark from '../../../atoms/site-wordmark/index.astro'
import { buttonSizes, buttonVariants } from '../../../atoms/button/variants'
import Icon from '../../../atoms/icon/index.astro'
import { iconNames } from '../../../atoms/icon/names'
import Image from '../../../atoms/image/index.astro'
import Price from '../../../atoms/price/index.astro'
import type { BoardHeroProps } from './types'

type Props = BoardHeroProps

const { heading, headingId = 'board-hero-heading', eyebrow, image, action, voltText, blackText, brandName, secondaryAction, product } = Astro.props
---

<section class="board-hero" aria-labelledby={headingId} data-band>
  <div class="board-hero__grid">
    <div class="board-hero__tile board-hero__photo" data-surface="dark">
      <Image class="board-hero__photo-img" {...image} isEager />
      <div class="board-hero__copy">
        {eyebrow && <p class="board-hero__eyebrow" style="--rise: 0">{eyebrow}</p>}
        <h1 id={headingId} class="board-hero__heading" style="--rise: 1">{heading}</h1>
        <div class="board-hero__actions" style="--rise: 2">
          <Button variant={buttonVariants.accent} size={buttonSizes.lg} href={action.href}>{action.label}</Button>
        </div>
      </div>
    </div>

    <div class="board-hero__tile board-hero__volt">
      <p class="board-hero__line">{voltText}</p>
    </div>

    <div class="board-hero__tile board-hero__black" data-surface="dark">
      <p class="board-hero__line">{blackText}</p>
      <div class="board-hero__brand">
        <SiteWordmark class="board-hero__wordmark" siteName={brandName} variant="fill" />
        {secondaryAction && <a class="board-hero__more" href={secondaryAction.href}>{secondaryAction.label}</a>}
      </div>
    </div>

    <div class="board-hero__tile board-hero__product">
      <Image class="board-hero__product-img" {...product.image} sizes="(min-width: 900px) 28vw, 100vw" />
      {product.label && <p class="board-hero__product-label">{product.label}</p>}
      <div class="board-hero__product-caption">
        <p class="board-hero__product-title"><a href={product.href} class="board-hero__product-link">{product.title}</a></p>
        <Price label={product.price.label} value={product.price.value} />
      </div>
      <span class="board-hero__product-arrow" aria-hidden="true"><Icon name={iconNames.arrowUpRight} size={20} /></span>
    </div>
  </div>
</section>

<style>
  /* Never a horizontal scrollbar from the 100vw breakout (the viewport width includes a scrollbar). */
  :global(html) {
    overflow-x: clip;
  }

  .board-hero {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(var(--space-40) * -1);
    padding: var(--space-12) var(--page-gutter);
    background: var(--surface-muted);
  }

  .board-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--grid-gap-tight);
    max-width: var(--page-max-width);
    height: clamp(520px, calc(100svh - var(--header-height) - var(--utility-bar-height) - var(--space-64)), 860px);
    margin-inline: auto;
  }

  .board-hero__tile {
    position: relative;
    isolation: isolate;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    container-type: size;
    border-radius: var(--radius-card);
  }

  /* Photo tile: the campaign shot under the scrim, copy bottom-left. */
  .board-hero__photo {
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--surface);
    color: var(--text-body);
  }

  .board-hero__photo::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--image-scrim);
    content: '';
  }

  .board-hero__photo-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    filter: brightness(0.86); /* token-lint-ignore: dims the photo so the headline reads */
  }

  .board-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
    padding: var(--space-32);
  }

  .board-hero__eyebrow {
    margin: 0;
    color: var(--text-primary);
    font: var(--type-label-caps-xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
  }

  .board-hero__heading {
    margin: 0;
    max-width: 8ch; /* token-lint-ignore: two lines, "GO / KEEP GOING" */
    color: var(--text-primary);
    font: 700 clamp(64px, 23cqw, 190px) / 0.84 var(--font-display); /* token-lint-ignore: fluid hero size with the tile */
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-display);
    text-transform: var(--text-case);
    text-wrap: balance;
  }

  .board-hero__actions {
    padding-top: var(--space-8);
  }

  /* Volt block: the first half of the brand line, as big as the block allows. */
  .board-hero__volt {
    grid-column: 2;
    grid-row: 1;
    background: var(--accent);
    color: var(--on-accent);
  }

  .board-hero__black {
    grid-column: 2 / 4;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-24);
    background: var(--surface);
    color: var(--text-primary);
  }

  .board-hero__line {
    margin: 0;
    box-sizing: border-box;
    max-width: calc(100% - var(--space-48));
    font: 700 min(54cqw, 40cqh) / 0.8 var(--font-display); /* token-lint-ignore: fills the block like the board's type */
    font-stretch: var(--display-stretch);
    letter-spacing: var(--tracking-display);
    text-transform: var(--text-case);
    white-space: pre-line;
  }

  .board-hero__volt .board-hero__line {
    position: absolute;
    z-index: 1;
    inset: var(--space-24) var(--space-24) auto;
    max-width: min(3ch, calc(100% - var(--space-48))); /* token-lint-ignore: stacks "ALL / IN" */
    font-size: min(66cqw, 50cqh, 42cqw); /* token-lint-ignore: two stacked words fill the block */
  }

  .board-hero__black .board-hero__line {
    font-size: min(36cqw, 64cqh); /* token-lint-ignore: one line in the wide block */
  }

  .board-hero__brand {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .board-hero__wordmark {
    width: min(46cqw, 320px); /* token-lint-ignore: the wordmark's own width */
    height: auto;
  }

  .board-hero__more {
    color: var(--text-primary);
    font: var(--type-text-medium-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .board-hero__more:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* Product tile: the packshot fills the tile, the caption sits on its light backdrop. */
  .board-hero__product {
    grid-column: 3;
    grid-row: 1;
    background: #efefef; /* token-lint-ignore: the packshots' own backdrop */
    color: var(--ink-950);
  }

  .board-hero__product-img {
    position: absolute;
    inset: 0 0 var(--space-64);
    z-index: -1;
    width: 100%;
    height: calc(100% - var(--space-64));
    object-fit: contain;
    object-position: 50% 50%;
  }

  .board-hero__product-label {
    position: absolute;
    z-index: 1;
    top: var(--space-16);
    left: var(--space-16);
    margin: 0;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-chip);
    background: var(--accent);
    color: var(--on-accent);
    font: var(--type-label-caps-2xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label-caps-2xs);
    text-transform: var(--label-case);
  }

  .board-hero__product-caption {
    position: absolute;
    z-index: 1;
    right: var(--space-16);
    bottom: var(--space-16);
    left: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-right: var(--space-48);
  }

  .board-hero__product-title {
    margin: 0;
    font: var(--type-title-md);
  }

  .board-hero__product-link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole tile is the target. */
  .board-hero__product-link::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .board-hero__product-link:focus-visible {
    outline: none;
  }

  .board-hero__product:has(.board-hero__product-link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .board-hero__product-arrow {
    position: absolute;
    z-index: 1;
    right: var(--space-16);
    bottom: var(--space-16);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-40);
    height: var(--space-40);
    border-radius: var(--radius-full);
    background: var(--ink-1000);
    color: var(--ink-0);
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .board-hero__product:hover .board-hero__product-arrow {
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .board-hero__photo-img,
    .board-hero__product-img {
      transition: transform var(--duration-slow) var(--ease-out);
    }

    .board-hero__photo:hover .board-hero__photo-img,
    .board-hero__product:hover .board-hero__product-img {
      transform: scale(var(--hover-zoom));
    }
  }

  /* The copy rises in once on load, one line after the other. */
  @media (prefers-reduced-motion: no-preference) {
    .board-hero__copy > * {
      animation: board-hero-rise var(--duration-slow) var(--ease-out) both;
      animation-delay: calc(var(--rise, 0) * var(--duration-fast) / 2);
    }
  }

  @keyframes board-hero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--space-16));
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .board-hero__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      height: auto;
    }

    .board-hero__photo {
      grid-column: 1 / 3;
      grid-row: auto;
      height: min(calc(100svh - var(--header-height) - var(--space-96)), 560px); /* token-lint-ignore: a tall first tile with a peek of the next */
      min-height: 420px; /* token-lint-ignore: never shorter than the headline needs */
    }

    .board-hero__volt,
    .board-hero__black {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 1;
    }

    .board-hero__black {
      grid-column: 2;
      padding: var(--space-16);
    }

    .board-hero__volt {
      grid-column: 1;
    }

    .board-hero__product {
      grid-column: 1 / 3;
      grid-row: auto;
      aspect-ratio: 16 / 10;
    }

    .board-hero__copy {
      padding: var(--space-24) var(--space-16);
    }

    .board-hero__heading {
      font-size: clamp(64px, 26cqw, 128px); /* token-lint-ignore: fluid phone size */
    }

    .board-hero__volt .board-hero__line {
      inset: var(--space-16) var(--space-16) auto;
      max-width: min(3ch, calc(100% - var(--space-32))); /* token-lint-ignore: stacks "ALL / IN" */
      font-size: min(38cqw, 32cqh, 30cqw); /* token-lint-ignore: stacked words fill the square */
    }

    .board-hero__black .board-hero__line {
      max-width: min(4ch, calc(100% - var(--space-32))); /* token-lint-ignore: stacks "ALL / OUT" */
      font-size: min(32cqw, 26cqh, 22cqw); /* token-lint-ignore: stacked words fill the square */
    }

    .board-hero__wordmark {
      width: 100%;
    }

    .board-hero__brand {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-8);
    }
  }

  /* Tablet: the photo on top, then the three brand tiles side by side (a stretched phone stack looks like a mistake at 768). */
  @media (min-width: 601px) and (max-width: 900px) {
    .board-hero__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .board-hero__photo {
      grid-column: 1 / 4;
    }

    .board-hero__volt,
    .board-hero__black,
    .board-hero__product {
      grid-column: auto;
      aspect-ratio: 4 / 5;
    }

    .board-hero__volt .board-hero__line,
    .board-hero__black .board-hero__line {
      max-width: min(3ch, calc(100% - var(--space-32))); /* token-lint-ignore: stacked words in the tile */
      font-size: min(40cqw, 34cqh); /* token-lint-ignore: stacked words fill the tile */
    }

    .board-hero__black .board-hero__line {
      max-width: none;
    }
  }

  @media (pointer: coarse) {
    .board-hero__more {
      display: inline-flex;
      align-items: center;
      min-height: 44px; /* token-lint-ignore: touch target */
    }
  }
</style>
