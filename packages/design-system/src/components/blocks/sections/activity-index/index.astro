---
// The "activityIndex" section (Fusion's "shop by activity", sharper): rows of huge condensed caps,
// each a link with an index number, the name, a count and an arrow that slides in on hover. Every
// row owns its photo: on a wide screen it is stacked in one fixed slot beside the list and revealed
// by a clip-path wipe while its row is hovered or focused (the first row's photo shows at rest, the
// other rows dim); on a phone it is the row's small thumbnail and nothing depends on hover.
import Icon from '../../../atoms/icon/index.astro'
import { iconNames } from '../../../atoms/icon/names'
import Image from '../../../atoms/image/index.astro'
import type { ActivityIndexProps } from './types'

type Props = ActivityIndexProps

const { heading, headingId, intro, items } = Astro.props
const pad = (index: number): string => String(index + 1).padStart(2, '0')
---

{
  items.length > 0 && (
    <section class="activity-index" aria-labelledby={headingId}>
      <div class="activity-index__layout">
        <header class="activity-index__head">
          <h2 id={headingId} class="activity-index__heading">{heading}</h2>
          {intro && <p class="activity-index__intro">{intro}</p>}
        </header>
        <div class="activity-index__body">
        <ul class="activity-index__list">
          {items.map((item, index) => (
            <li class="activity-index__item">
              <a class="activity-index__row" href={item.href}>
                <span class="activity-index__num" aria-hidden="true">{pad(index)}</span>
                <span class="activity-index__label">{item.label}</span>
                <span class="activity-index__count">{item.countLabel}</span>
                <span class="activity-index__arrow" aria-hidden="true"><Icon name={iconNames.arrowRight} /></span>
              </a>
              <div class="activity-index__photo"><Image {...item.image} /></div>
            </li>
          ))}
        </ul>
        <div class="activity-index__slot" aria-hidden="true"></div>
        </div>
      </div>
    </section>
  )
}

<style>
  .activity-index {
    padding-block: var(--space-64);
    container: activity-index / inline-size;
  }

  .activity-index__layout {
    display: grid;
    gap: var(--space-32);
  }

  .activity-index__body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30%);
    align-items: start;
  }

  .activity-index__slot {
    aspect-ratio: 4 / 5;
  }

  .activity-index__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8) var(--space-32);
  }

  .activity-index__heading {
    margin: 0;
    font: var(--type-label-caps-xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
  }

  .activity-index__intro {
    max-width: 44ch;
    margin: 0;
    color: var(--text-secondary);
    font: var(--type-text-regular-sm);
  }

  .activity-index__list {
    margin: 0 var(--space-48) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--border-strong);
    list-style: none;
  }

  .activity-index__item {
    border-top: 1px solid var(--border-strong);
  }

  .activity-index__row {
    display: grid;
    grid-template-columns: var(--space-48) minmax(0, 1fr) auto var(--space-48);
    align-items: center;
    padding-block: var(--space-16);
    color: var(--text-primary);
    text-decoration: none;
  }

  .activity-index__row:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .activity-index__num {
    align-self: start;
    padding-top: var(--space-16);
    color: var(--text-secondary);
    font: var(--type-label-caps-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
  }

  .activity-index__label {
    font: var(--type-display-2xl);
  }

  .activity-index__count {
    color: var(--text-secondary);
    font: var(--type-label-caps-xs);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
  }

  .activity-index__arrow {
    display: flex;
    justify-content: flex-end;
  }

  .activity-index__arrow :global(svg) {
    width: 28px;
    height: 28px;
  }

  /* Wide: photos stack in the slot to the right of the list, under the heading. */
  .activity-index__photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 30%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-muted);
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
  }

  .activity-index__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .activity-index__list:not(:has(.activity-index__row:hover, .activity-index__row:focus-visible)) .activity-index__item:first-child .activity-index__photo,
  .activity-index__item:has(.activity-index__row:hover, .activity-index__row:focus-visible) .activity-index__photo {
    clip-path: inset(0);
  }

  .activity-index__item:has(.activity-index__row:hover, .activity-index__row:focus-visible) .activity-index__photo {
    z-index: 1;
  }

  @media (hover: hover) {
    .activity-index__list:has(.activity-index__row:hover) .activity-index__row:not(:hover) {
      color: var(--text-subtle);
    }

    .activity-index__row:hover .activity-index__label {
      text-decoration: underline;
    }
  }

  @container activity-index (width < 1100px) {
    .activity-index__label {
      font: var(--type-display-xl);
    }
  }

  /* Narrow: no side slot, each row carries a thumbnail. */
  @container activity-index (width < 760px) {
    .activity-index__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .activity-index__slot {
      display: none;
    }

    .activity-index__list {
      margin-right: 0;
    }

    .activity-index__row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'label arrow' 'count arrow';
      row-gap: var(--space-4);
      padding-block: var(--space-12);
      padding-left: calc(64px + var(--space-16)); /* token-lint-ignore: thumbnail column */
      min-height: 96px; /* token-lint-ignore: thumbnail row height */
    }

    .activity-index__num {
      display: none;
    }

    .activity-index__label {
      grid-area: label;
      font: var(--type-display-lg);
    }

    .activity-index__count {
      grid-area: count;
    }

    .activity-index__arrow {
      grid-area: arrow;
    }

    .activity-index__arrow :global(svg) {
      width: 20px;
      height: 20px;
    }

    .activity-index__item {
      position: relative;
    }

    .activity-index__photo,
    .activity-index__list:not(:has(.activity-index__row:hover, .activity-index__row:focus-visible)) .activity-index__item:first-child .activity-index__photo {
      top: var(--space-12);
      right: auto;
      bottom: var(--space-12);
      left: 0;
      width: 64px; /* token-lint-ignore: thumbnail */
      height: auto;
      aspect-ratio: auto;
      clip-path: none;
    }

  }
</style>
