---
// The brand band (from the brand board): a full-bleed static band with one line of text, centred.
// It used to scroll; the wireframe has no motion, so the line stands still.
import type { BrandMarqueeProps } from './types'
import { brandMarqueeTones } from './variants'

type Props = BrandMarqueeProps

const { text, tone = brandMarqueeTones.volt } = Astro.props
---

<div class:list={['brand-marquee', `brand-marquee--${tone}`]} data-surface={tone === brandMarqueeTones.dark ? 'dark' : undefined} data-band>
  <p class="brand-marquee__group"><span class="brand-marquee__item">{text}</span></p>
</div>

<style>
  .brand-marquee {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    border-block: 1px solid var(--border);
    background: var(--surface-muted);
    color: var(--text-primary);
    user-select: none;
  }

  .brand-marquee--volt {
    background: var(--accent);
    color: var(--on-accent);
  }

  .brand-marquee--dark {
    background: var(--surface);
  }

  .brand-marquee__group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: var(--space-16) var(--page-gutter);
    font: var(--type-display-xl);
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 640px) {
    .brand-marquee__group {
      font: var(--type-display-lg);
    }
  }
</style>
