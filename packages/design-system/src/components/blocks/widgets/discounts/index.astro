---
// Figma "Frame 481314" (944:29579): a row of three deal cards (325.33×432 each, 16px gap). In a
// bar the cards stack at the bar's width. Renders nothing without deals.
import TileTitle from '../../../molecules/tile-title/index.astro'
import DealCard from '../../../parts/deal-card/index.astro'
import type { DiscountsProps } from './types'

type Props = DiscountsProps

const { variant, heading, headingId, deals } = Astro.props
// A headed block is a labelled region; without a heading it is a plain group of cards.
const Wrapper = heading ? 'section' : 'div'
---

{
  deals.length > 0 && (
    <Wrapper class:list={['discounts', `discounts--${variant}`]} aria-labelledby={heading ? headingId : undefined}>
      {heading && <TileTitle heading={heading} headingId={headingId} />}
      <div class="discounts__cards">
        {deals.map((deal) => (
          <DealCard deal={deal} />
        ))}
      </div>
    </Wrapper>
  )
}

<style>
  .discounts {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .discounts__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--stack-gap);
  }

  .discounts__cards > :global(.deal-card) {
    height: 100%;
  }

  .discounts--stack .discounts__cards {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Three ~215px cards are too narrow for the CTA in the two-column page below 1100px: two per
     row, an odd last card spanning the row. */
  @media (max-width: 1100px) {
    .discounts--row .discounts__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .discounts--row .discounts__cards > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .discounts--row .discounts__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
