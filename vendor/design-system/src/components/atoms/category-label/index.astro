---
// Figma "category-label-small" (625:3966) and "category-label-large" (685:24380): one uppercase
// pill per category — the category color is the fill, or (inverted, large only in Figma) the text
// on a white pill. Small: 20px tall, label-semibold-xs; large: 30px, label-semibold-md.
// The inverted pill is white; a caller can override its fill with `--category-label-inverted-bg`.
// On a dark surface the pill gets a light 1px outline, so the dark category tones stay visible.
// The colour is a palette key (`category`) or any CSS colour (`color`, a CMS category's hex),
// which wins; with neither the pill falls back to neutral-800.
import { categoryColor } from '../../../utils/category-color'
import { categoryLabelSizes, type CategoryKey, type CategoryLabelSize } from './variants'

interface Props {
  category?: CategoryKey
  color?: string
  size?: CategoryLabelSize
  isInverted?: boolean
  class?: string
}

const { category, color, size = categoryLabelSizes.s, isInverted = false, class: className } = Astro.props
const pillColor = categoryColor({ color, key: category })
---

<span
  class:list={['category-label', `category-label--${size}`, isInverted && 'category-label--inverted', className]}
  style={pillColor ? `--category-label-color: ${pillColor}` : undefined}
  data-category={category}
>
  <slot />
</span>

<style>
  /* Figma sizes auto-width text up to the next whole pixel; `calc-size` reproduces it where
     supported (elsewhere the label is ≤1px narrower). */
  .category-label {
    width: calc-size(max-content, round(up, size, 1px));
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-chip);
    background: var(--category-label-color, var(--ink-800));
    color: var(--on-color);
    text-transform: var(--label-case);
    font-stretch: var(--label-stretch);
    letter-spacing: var(--tracking-label);
    white-space: nowrap;
  }

  .category-label--inverted {
    background: var(--category-label-inverted-bg, var(--ink-0));
    color: var(--category-label-color, var(--ink-800));
  }

  :global([data-surface='dark']) .category-label:not(.category-label--inverted) {
    border: 1px solid color-mix(in srgb, var(--ink-0) 40%, transparent);
  }

  .category-label--s {
    height: 20px;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    font: var(--type-label-caps-2xs);
  }

  .category-label--l {
    gap: var(--space-8);
    padding: var(--space-6) var(--space-8);
    font: var(--type-label-caps-xs);
  }
</style>
