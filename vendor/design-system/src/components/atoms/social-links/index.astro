---
// Social links — a row of icon buttons (the design shows YouTube, Facebook, Instagram; the atom
// takes any list the caller provides).
// Each icon is caller-supplied raw markup (no icon-library dependency added here).
import { socialLinksVariants, type SocialLinksVariant } from './variants'

export interface SocialLinkItem {
  readonly href: string
  readonly label: string
  readonly icon: string
}

interface Props {
  links: readonly SocialLinkItem[]
  variant?: SocialLinksVariant
}

const { links, variant = socialLinksVariants.round } = Astro.props
---

<ul class:list={['social-links', `social-links--${variant}`]}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} aria-label={link.label}>
          <span class="social-links__icon" set:html={link.icon} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    list-style: none;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }

  .social-links a {
    display: flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--surface-muted);
    color: var(--text-primary);
  }

  .social-links--square a {
    border-radius: var(--radius-chip);
    background: var(--surface-muted);
    color: var(--text-primary);
  }

  .social-links__icon {
    display: flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
  }
</style>
