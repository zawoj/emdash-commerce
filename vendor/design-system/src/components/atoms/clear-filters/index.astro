---
// Clear filters — an "x" icon plus text, resetting the active
// filters. Always a <button>: clearing filters is a script action (see scroll-button for the
// same pattern). The "x" glyph comes through the `icon` slot, so no icon library is a dependency
// here.
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<button type="button" class:list={['clear-filters', className]}>
  <span class="clear-filters__icon"><slot name="icon" /></span>
  <span class="clear-filters__label"><slot /></span>
</button>

<style>
  .clear-filters {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) 0;
    border: none;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }

  @media (hover: hover) {
    .clear-filters:hover {
      color: var(--text-primary);
    }
  }

  .clear-filters:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .clear-filters__icon {
    display: inline-flex;
    width: 14px;
    height: 14px;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .clear-filters__label {
    font: var(--type-button-sm-md);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
