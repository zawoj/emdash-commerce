---
// Figma 1017:40838 "section" tile (deals listing): a borderless tile holding a grid of cards — three
// 411.333px cards, 20px gaps, centred in the 1277px tile-content; two columns below 1100px, one
// below 640px. Cards in a row stretch to one height. Without cards the tile shows `emptyLabel`.
import type { CardGridProps } from './types'

type Props = CardGridProps

const { isEmpty = false, emptyLabel } = Astro.props
---

<div class="card-grid">
  {
    isEmpty ? (
      <p class="card-grid__empty">{emptyLabel}</p>
    ) : (
      <div class="card-grid__cards">
        <slot />
      </div>
    )
  }
</div>

<style>
  .card-grid {
    width: 100%;
    padding: var(--space-20);
    border-radius: var(--radius-card);
  }

  .card-grid__empty {
    margin: 0;
    text-align: center;
    font: var(--type-text-regular-md);
    color: var(--text-secondary);
  }

  /* Figma: three 411.333px cards + two 20px gaps = 1274px, centred in the tile. */
  .card-grid__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    max-width: 1274px; /* token-lint-ignore: Figma 3 x 411.333 + 2 x 20, no token */
    margin: 0 auto;
  }

  @media (max-width: 1100px) {
    .card-grid {
      padding: var(--space-20) 0;
    }

    .card-grid__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .card-grid {
      padding: var(--space-8) 0;
    }

    .card-grid__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--grid-gap-tight);
    }
  }
</style>
