---
// Figma "tagi" / popularne-widget-R (915:28447; home "Popularne tagi", identical on
// wpisy-z-kategorii): a black tile with the textured "#" glyph behind a tile-title and the Tag
// pills wrapping over as many rows as they need.
import Tag from '../../atoms/tag/index.astro'
import TileTitle from '../../molecules/tile-title/index.astro'
import type { TagsWidgetContent } from './types'

type Props = TagsWidgetContent

const { heading, headingId, tags } = Astro.props
---

<section class="tags-widget" data-surface="dark" aria-labelledby={headingId}>
  <TileTitle heading={heading} headingId={headingId} />
  <ul class="tags-widget__list">
    {
      tags.map((tag) => (
        <li>
          <a class="tags-widget__link" href={tag.href}>
            <Tag>{tag.label}</Tag>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tags-widget {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    overflow: hidden;
    padding: var(--space-24);
    border-radius: var(--radius-card);
    background: var(--ink-1000);
  }

  .tags-widget :global(.tile-title) {
    position: relative;
  }

  .tags-widget__list {
    position: relative;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags-widget__list li {
    display: flex;
  }

  .tags-widget__link {
    display: flex;
    color: inherit;
    text-decoration: none;
  }
</style>
