---
// Figma home "section" (944:29108), top row: the lead article slider (766px) beside the "hot"
// tile (610px), 16px apart. Below 1100px the slider stacks over the tile. Each half renders only
// when it has content; the page's H1 is visually hidden.
import HotTile from './hot-tile.astro'
import LeadSlider from './lead-slider.astro'
import type { HeroHomeProps } from './types'

type Props = HeroHomeProps

const { title, sliderLabel, slides, hot, index = 1 } = Astro.props
const hasSlides = slides.length > 0
const hasHot = Boolean(hot && hot.articles.length > 0)
---

{
  (hasSlides || hasHot) && (
    <div class="hero-home">
      {title && <h1 class="hero-home__title">{title}</h1>}
      {hasSlides && <LeadSlider slides={slides} label={sliderLabel} isFirst={index === 0} />}
      {hot && hasHot && <HotTile {...hot} />}
    </div>
  )
}

<style>
  .hero-home {
    display: flex;
    flex-direction: row;
    gap: var(--space-16);
  }

  .hero-home__title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Figma's widths as flex bases (766 + 16 + 610 = the 1392px row); they shrink proportionally. */
  .hero-home > :global(.lead-slider) {
    flex: 1 1 766px;
    min-width: 0;
  }

  .hero-home > :global(.hot-tile) {
    flex: 1 1 610px;
  }

  @media (max-width: 1100px) {
    .hero-home {
      flex-direction: column;
    }

    .hero-home > :global(.lead-slider),
    .hero-home > :global(.hot-tile) {
      flex: none;
    }
  }
</style>
