{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e",
  "tags": ["type:e2e"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p e2e/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/playwright.config.ts", { "externalDependencies": ["typescript", "@playwright/test", "@axe-core/playwright"] }]
    }
  }
}
