---
import CartPageFragment from "../features/cart/components/CartPageFragment.astro";
import { CHECKOUT_NOTICE_PARAM, checkoutNoticeMessage } from "../features/cart/checkout-notice";
import { loadCartPage } from "../features/cart/summary";
import Base from "../layouts/Base.astro";
import { resolveLocale } from "../lib/i18n";
import { cartStrings } from "../lib/strings";
import { getSiteLocale } from "../utils/locale";

const locale = resolveLocale(getSiteLocale());
const copy = cartStrings(locale);
const initialAlert = checkoutNoticeMessage(Astro.url.searchParams.get(CHECKOUT_NOTICE_PARAM), copy);
const model = await loadCartPage(Astro.request, locale, copy);
---

<Base title={copy.cartTitle} pageTitle={copy.cartTitle}>
	<section class="cart-page" data-cart-page>
		<h1 class="cart-page__title">{copy.cartTitle}</h1>
		{
			model ? (
				<CartPageFragment copy={copy} model={model} initialAlert={initialAlert} />
			) : (
				<p>{copy.loadFailed}</p>
			)
		}
	</section>
	<script>
		import "../features/cart/client/cart-page.client";
	</script>
</Base>

<style>
	.cart-page {
		padding: var(--space-24) var(--page-gutter) var(--space-64);
		display: flex;
		flex-direction: column;
		gap: var(--space-24);
		max-width: var(--page-max);
		margin-inline: auto;
	}

	.cart-page__title {
		margin: 0;
		font: var(--type-display-md);
		font-stretch: var(--display-stretch);
		letter-spacing: var(--tracking-display);
		text-transform: var(--text-case);
	}
</style>