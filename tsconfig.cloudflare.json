{
	// Typechecks the Cloudflare Worker entry against Wrangler's generated runtime types (pnpm types:cloudflare). Not
	// extended from tsconfig.json on purpose: those runtime types replace the DOM lib instead of joining it.
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"types": [],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/worker.ts", "worker-configuration.d.ts"]
}
