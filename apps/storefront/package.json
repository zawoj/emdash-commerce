{
  "name": "@emdash-commerce/storefront",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Blog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --port 4360",
    "build": "astro build",
    "preview": "astro preview --port 4360",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@emdash-commerce/design-system": "workspace:*",
    "@emdash-commerce/plugin-image-hotspots": "workspace:*",
    "@emdash-commerce/plugin-stripe": "workspace:*",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "astro": "7.3.2",
    "emdash": "^1.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "4.14.0",
    "happy-dom": "20.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "description": "Mock Cloudflare-merch storefront on EmDash (Astro, Node + SQLite): catalog, cart and Stripe Checkout through the stripe-commerce plugin."
}
