# 32-byte hex key used by EmDash to encrypt secrets stored in the database.
# Generate with: openssl rand -hex 32  (apps/storefront/.env is git-ignored)
EMDASH_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Optional fallbacks for @emdash-commerce/plugin-stripe (prefer plugin settings in admin)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
