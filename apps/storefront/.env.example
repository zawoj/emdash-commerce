# --- EmDash ---------------------------------------------------------------------------------------------
# Key EmDash uses to encrypt secrets stored in the database (plugin settings saved in the admin, the guest order-link
# secret). Format: emdash_enc_v1_ followed by 43 base64url characters (32 random bytes); a bare hex key is rejected.
# Generate: npx emdash secrets generate (or pnpm bootstrap). Keep it stable: changing it makes stored secrets unreadable.
# apps/storefront/.env is git-ignored; pnpm dev loads it (plain `astro dev` does not).
EMDASH_ENCRYPTION_KEY=replace-with-emdash-secrets-generate

# --- Stripe (sandbox only for local work, never a live key) ------------------------------------------------
# Fallbacks for @emdash-commerce/plugin-stripe: a value saved in the admin (Plugins, Stripe commerce, Settings) wins.
# Sandbox secret key (sk_test_...) or, better, a restricted key (rk_test_...); permissions: docs/getting-started.md.
# Without it the shop loads but anything that calls Stripe answers NOT_CONFIGURED.
STRIPE_SECRET_KEY=sk_test_replace_me

# The whsec_... that `stripe listen --forward-to localhost:4360/_emdash/api/plugins/stripe-commerce/webhook` prints.
# It differs per machine and per Stripe CLI login; restart the server after changing it. A wrong value shows up as
# [400] on every forwarded event in the `stripe listen` output.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: signs the links in guest order emails. Generated on first activation when EMDASH_ENCRYPTION_KEY is set.
# COMMERCE_ACCESS_TOKEN_SECRET=

# --- Email (optional locally, required on a deployed site; docs/email.md) -------------------------------------
# Order confirmations, guest order links, magic links and invites go through EmDash's email provider. Locally a console
# provider captures them (/_emdash/api/dev/emails). Keep these commented out unless you want real delivery: a complete
# set makes EmDash's built-in SMTP provider the active one, in dev too. Port 25 is not supported: 587 (STARTTLS) or 465 (TLS).
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=starttls
# EMAIL_SMTP_USER=replace-with-smtp-username
# EMAIL_SMTP_PASS=replace-with-smtp-password
# The sender must be an address your provider accepts. Needed when the username is not itself an address (an API-key user).
# EMAIL_SMTP_FROM_EMAIL=orders@example.com
# EMAIL_SMTP_FROM_NAME=Your Shop
# EMAIL_SMTP_REPLY_TO=support@example.com
