# --- EmDash ---------------------------------------------------------------------------------------------
# 32-byte hex key EmDash uses to encrypt secrets stored in the database (plugin settings saved in the admin, the
# guest order-link secret). Generate: openssl rand -hex 32 . Keep it stable: changing it makes stored secrets unreadable.
# apps/storefront/.env is git-ignored; pnpm dev loads it (plain `astro dev` does not).
EMDASH_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# --- Stripe (sandbox only for local work, never a live key) ------------------------------------------------
# Fallbacks for @emdash-commerce/plugin-stripe: a value saved in the admin (Plugins, Stripe commerce, Settings) wins.
# Sandbox secret key (sk_test_...) or, better, a restricted key (rk_test_...); permissions: docs/getting-started.md.
# Without it the shop loads but anything that calls Stripe answers NOT_CONFIGURED.
STRIPE_SECRET_KEY=sk_test_replace_me

# The whsec_... that `stripe listen --forward-to localhost:4360/_emdash/api/plugins/stripe-commerce/webhook` prints.
# It differs per machine and per Stripe CLI login; restart the server after changing it. A wrong value shows up as
# [400] on every forwarded event in the `stripe listen` output.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: signs the links in guest order emails. Generated on first activation when EMDASH_ENCRYPTION_KEY is set.
# COMMERCE_ACCESS_TOKEN_SECRET=
