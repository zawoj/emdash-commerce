---
import { ARCHIVE_VIEW } from "../utils/archive-controls-shared";

export interface ArchiveControlField {
	name: string;
	label: string;
	options: { value: string; label: string }[];
	value: string;
	/** Differs from the default, so the control is marked as in use. */
	isActive: boolean;
}

interface Props {
	/** Path of the archive, e.g. "/posts" */
	basePath: string;
	fields: ArchiveControlField[];
	view: (typeof ARCHIVE_VIEW)[keyof typeof ARCHIVE_VIEW];
	/** Query values that differ from defaults, for building layout links. */
	formDefaults: Record<string, string>;
	isCustomised: boolean;
	hrefFor: (patch: { view?: (typeof ARCHIVE_VIEW)[keyof typeof ARCHIVE_VIEW] }) => string;
	/** e.g. "4 posts"; left out when it would be misleading (later pages). */
	resultLabel?: string;
	ariaLabel: string;
}

const {
	basePath,
	fields,
	view,
	formDefaults,
	isCustomised,
	hrefFor,
	resultLabel,
	ariaLabel,
} = Astro.props;

const viewLinks = [
	{ view: ARCHIVE_VIEW.LIST, label: "List layout" },
	{ view: ARCHIVE_VIEW.GRID, label: "Grid layout" },
];
---

<div class="band archive-toolbar">
	<div class="frame">
		<form
			class="archive-controls"
			method="get"
			action={basePath}
			aria-label={ariaLabel}
			data-archive-controls
			data-form-defaults={JSON.stringify(formDefaults)}
		>
			{
				fields.map((field) => (
					<label class:list={["archive-controls__field", `archive-controls__field--${field.name}`]}>
						<span class="archive-controls__label">{field.label}</span>
						<span class="archive-controls__select-wrap">
							<select
								name={field.name}
								class="archive-controls__select"
								data-active={field.isActive ? "" : undefined}
							>
								{field.options.map((option) => (
									<option value={option.value} selected={option.value === field.value}>
										{option.label}
									</option>
								))}
							</select>
							<svg
								class="archive-controls__chevron"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</span>
					</label>
				))
			}

			<input type="hidden" name="view" value={view} />
			<button type="submit" class="btn btn--sm archive-controls__apply" data-archive-apply>
				Apply
			</button>

			{
				isCustomised && (
					<a href={basePath} class="btn btn--ghost btn--sm archive-controls__reset">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M18 6 6 18M6 6l12 12" />
						</svg>
						Reset
					</a>
				)
			}

			<div class="archive-controls__meta">
				{
					resultLabel && (
						<p class="archive-controls__count" aria-live="polite">
							{resultLabel}
						</p>
					)
				}
				<div class="archive-controls__view" role="group" aria-label="Layout">
					{
						viewLinks.map(({ view: layout, label }) => (
							<a
								href={hrefFor({ view: layout })}
								class="icon-btn archive-controls__view-link"
								aria-label={label}
								title={label}
								aria-current={layout === view ? "true" : undefined}
							>
								{layout === ARCHIVE_VIEW.LIST ? (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
									</svg>
								) : (
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<rect x="3" y="3" width="7" height="7" rx="1" />
										<rect x="14" y="3" width="7" height="7" rx="1" />
										<rect x="3" y="14" width="7" height="7" rx="1" />
										<rect x="14" y="14" width="7" height="7" rx="1" />
									</svg>
								)}
							</a>
						))
					}
				</div>
			</div>
		</form>
	</div>
</div>

<script>
	// With scripts on, a changed select applies at once and the Apply button is not needed. The link keeps only
	// what differs from the defaults, like the layout links do (without scripts the form still works, with a longer URL).
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-archive-controls]")) {
		const defaults = JSON.parse(form.dataset.formDefaults ?? "{}") as Record<string, string>;
		form.querySelector<HTMLElement>("[data-archive-apply]")?.setAttribute("hidden", "");
		form.addEventListener("change", () => form.requestSubmit());
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const params = new URLSearchParams();
			for (const [name, value] of new FormData(form)) {
				if (typeof value === "string" && value !== "" && value !== defaults[name]) {
					params.set(name, value);
				}
			}
			const query = params.toString();
			location.assign(query ? `${form.action}?${query}` : form.action);
		});
	}
</script>

<style>
	.archive-toolbar {
		padding-block: var(--spacing-5);
	}

	.archive-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: var(--spacing-3);
	}

	/* Same width for filters, so the row reads as a set */
	.archive-controls__field {
		display: grid;
		flex: 0 0 11.5rem;
		gap: var(--spacing-1);
		min-width: 0;
	}

	.archive-controls__label {
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 500;
		padding-inline: var(--spacing-1);
	}

	.archive-controls__select-wrap {
		position: relative;
		display: block;
	}

	.archive-controls__select {
		appearance: none;
		display: block;
		width: 100%;
		height: 2.25rem;
		padding-inline: var(--spacing-4) 2.25rem;
		border: 0;
		border-radius: var(--radius-full);
		background: var(--color-surface);
		box-shadow:
			inset 0 0 0 1px var(--color-border),
			var(--shadow-sm);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
		text-overflow: ellipsis;
		cursor: pointer;
		transition: box-shadow var(--transition-fast);
	}

	.archive-controls__select:hover {
		box-shadow:
			inset 0 0 0 1px var(--color-border-strong),
			var(--shadow-sm);
	}

	/* A filter or sort that is in use: a stronger outline and weight, so it is clear what narrows the list */
	.archive-controls__select[data-active] {
		box-shadow:
			inset 0 0 0 1.5px var(--color-brand),
			var(--shadow-sm);
		font-weight: 500;
	}

	.archive-controls__select:focus-visible {
		outline: 2px solid transparent;
		box-shadow:
			inset 0 0 0 1.5px var(--color-brand),
			0 0 0 3px var(--color-brand-ring);
	}

	.archive-controls__chevron {
		position: absolute;
		inset-inline-end: var(--spacing-3);
		top: 50%;
		width: 14px;
		height: 14px;
		translate: 0 -50%;
		color: var(--color-muted);
		pointer-events: none;
	}

	.archive-controls__apply[hidden] {
		display: none;
	}

	.archive-controls__reset {
		min-height: 2.25rem;
		color: var(--color-text-secondary);
	}

	.archive-controls__meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		margin-inline-start: auto;
	}

	.archive-controls__count {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.archive-controls__view {
		display: flex;
		gap: var(--spacing-1);
	}

	.archive-controls__view-link[aria-current="true"] {
		background: var(--color-brand);
		color: var(--color-on-brand);
		box-shadow: none;
	}

	@media (max-width: 720px) {
		.archive-controls {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: end;
		}

		.archive-controls__field {
			flex: none;
		}

		/* Sort gets a full row; the count and layout switch close the block */
		.archive-controls__field--sort {
			grid-column: 1 / -1;
		}

		.archive-controls__reset {
			justify-self: start;
		}

		.archive-controls__meta {
			grid-column: 1 / -1;
			justify-content: space-between;
			margin-inline-start: 0;
		}
	}
</style>
